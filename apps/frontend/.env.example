# Where the Next.js server reaches the NestJS backend.
BACKEND_URL=http://localhost:3030

# How many seconds the browser remembers the visitor's light/dark choice.
# Leave empty to forget the choice when the browser closes.
THEME_COOKIE_MAX_AGE=31536000

# How many seconds the browser keeps the login cookie; keep it equal to the
# backend's JWT_EXPIRES_IN. Leave empty to log out when the browser closes.
AUTH_COOKIE_MAX_AGE=3600
