# Runtime mode of the backend: development, test or production.
NODE_ENV=development

# Port the NestJS backend listens on.
PORT=3030

# Postgres user, password and database name for the local Docker database (compose.yaml).
POSTGRES_USER=jobscraper
POSTGRES_PASSWORD=jobscraper
POSTGRES_DB=jobscraper

# Host port the Docker database listens on; 5433 avoids clashing with a local Postgres on 5432.
POSTGRES_PORT=5433

# Connection string the backend uses to reach Postgres; for the local Docker
# database it must match the POSTGRES_* values above.
DATABASE_URL=postgres://jobscraper:jobscraper@localhost:5433/jobscraper

# bcrypt cost factor used to hash passwords; each +1 doubles the hashing time.
BCRYPT_SALT_ROUNDS=12

# Minimum number of characters a new password must have when registering.
PASSWORD_MIN_LENGTH=8

# Secret used to sign and verify login tokens (JWTs). Use a long random value,
# e.g. generated with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# How many seconds a login token stays valid (3600 = 1 hour).
JWT_EXPIRES_IN=3600

# OpenAI API key used to fill in missing JSON values (POST /ai/supplement).
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=change-me-to-your-openai-api-key

# OpenAI model used for the requests.
OPENAI_MODEL=gpt-5-mini

# CompanyEnrich API base URL and key used by the company sync.
# Create a key at https://app.companyenrich.com (each company returned costs 1 credit).
COMPANYENRICH_API_URL=https://api.companyenrich.com
COMPANYENRICH_API_KEY=change-me-to-your-companyenrich-api-key

# How many companies the sync fetches for each city in
# src/common/utils/target-cities.json (1-100). 50 x 12 cities = ~600 credits per run.
COMPANYENRICH_COMPANIES_PER_CITY=50

# Cron expression for the CompanyEnrich sync (default: Mondays at 03:00).
COMPANYENRICH_SYNC_CRON='0 3 * * 1'

# Wikidata SPARQL endpoint used by the company sync.
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql

# User-Agent sent to Wikidata; Wikimedia requires a name and a contact address.
WIKIDATA_USER_AGENT='JobScraper/0.1 (change-me@example.com)'

# Cron expression for the Wikidata sync (default: daily at 02:00).
WIKIDATA_SYNC_CRON='0 2 * * *'
