# Runtime mode of the backend: development, test or production.
NODE_ENV=development

# Port the NestJS backend listens on.
PORT=3030

# Postgres user, password and database name for the local Docker database (compose.yaml).
POSTGRES_USER=jobscraper
POSTGRES_PASSWORD=jobscraper
POSTGRES_DB=jobscraper

# Host port the Docker database listens on; 5433 avoids clashing with a local Postgres on 5432.
POSTGRES_PORT=5433
