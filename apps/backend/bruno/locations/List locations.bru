meta {
  name: List locations
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/locations?search=berg&state=Bavaria
  body: none
  auth: inherit
}

params:query {
  search: berg
  state: Bavaria
  ~countryCode: DE
  ~limit: 20
}

script:post-response {
  if (res.status === 200) {
    // First three ids, used by Get location and Update profile
    ["locationId", "locationId1", "locationId2"].forEach((name, i) => {
      if (res.body[i]) bru.setEnvVar(name, res.body[i].id);
    });
  }
}

docs {
  Locations ordered by country, state, city. Enable a query param to filter.
  Stores the first three results' ids as `locationId`, `locationId1` and
  `locationId2` for **Get location** and **Update profile**.
  
  - `search`: case-insensitive match on country, state or city
  - `countryCode`: two letters, e.g. DE
  - `state`: exact state name (case-insensitive)
  - `limit`: 1–200, default 50
  - 400: invalid filter · 401: run Login
}
