meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "testuser",
    "password": "test1234"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.access_token);
  }
}

docs {
  Returns `{ access_token }` and stores it as `accessToken` for all
  protected requests.
  
  - 401: wrong username or password
}
