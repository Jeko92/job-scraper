meta {
  name: Get company by ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/companies/{{companyId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

params:path {
  companyId: 12345678-1234-1234-1234-123456789012
}

docs {
  Get a single company by its UUID.
  
  - `companyId`: The UUID of the company
  
  - 200: OK - company object
  - 400: Bad Request - ID is not a UUID
  - 404: Not Found - unknown ID
  - 401: Unauthorized - run Login
  - 403: Forbidden - not an admin, run Login as admin
}
