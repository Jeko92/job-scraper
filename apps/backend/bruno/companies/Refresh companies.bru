meta {
  name: Refresh companies
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/companies/refresh
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

params:query {
  ~providers: wikidata,company-enrich
  ~mergeResults: true
}

body:json {
  {
    "query": "Siemens",
    "location": "Germany",
    "industry": "Technology",
    "minEmployees": 100,
    "maxEmployees": 10000,
    "foundedAfter": 1900,
    "foundedBefore": 2020,
    "limit": 10,
    "offset": 0
  }
}

docs {
  Refresh company data from external APIs and save to database.
  
  This endpoint fetches data from external APIs and automatically saves it to the database.
  
  Query Parameters:
  - `providers`: comma-separated list of providers (wikidata, company-enrich), default: wikidata,company-enrich
  - `mergeResults`: whether to merge and deduplicate results (default: true)
  
  Request Body (CompanySearchParams):
  - `query`: search query (optional)
  - `location`: location filter (optional)
  - `industry`: industry filter (optional)
  - `minEmployees`: minimum employees (optional)
  - `maxEmployees`: maximum employees (optional)
  - `foundedAfter`: minimum founded year (optional)
  - `foundedBefore`: maximum founded year (optional)
  - `limit`: maximum results per provider, 1-100, default 20
  - `offset`: pagination offset, default 0
  
  Always saves results to database (saveToDatabase is forced to true).
  
  Returns an array of saved company objects.
  
  - 200: OK - array of saved companies
  - 400: Bad Request - invalid parameters
  - 401: Unauthorized - run Login
  - 403: Forbidden - not an admin, run Login as admin
}
