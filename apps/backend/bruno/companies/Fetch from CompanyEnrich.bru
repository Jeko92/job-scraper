meta {
  name: Fetch companies from CompanyEnrich
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/companies/fetch/company-enrich
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

body:json {
  {
    "query": "allgeier",
  //   "location": "DE",
  //   "industry": "Technology",
  //   "minEmployees": 100,
  //   "maxEmployees": 10000,
  //   "foundedAfter": 1900,
  //   "foundedBefore": 2020,
    "limit": 10,
    "offset": 0
  }
}

docs {
  Fetch companies from CompanyEnrich only.

  Request Body (CompanySearchParams):
  - `query`: search query (optional)
  - `location`: country code (optional)
  - `industry`: industry filter (optional)
  - `minEmployees`: minimum employees (optional)
  - `maxEmployees`: maximum employees (optional)
  - `foundedAfter`: minimum founded year (optional)
  - `foundedBefore`: maximum founded year (optional)
  - `limit`: maximum results, 1-100, default 20
  - `offset`: pagination offset, default 0

  - 200: OK - array of normalized companies
  - 400: Bad Request - invalid parameters
  - 401: Unauthorized - run Login
  - 403: Forbidden - not an admin, run Login as admin
  - 500: Internal Server Error - CompanyEnrich request failed
}
