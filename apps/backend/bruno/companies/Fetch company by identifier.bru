meta {
  name: Fetch company by identifier
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/companies/fetch/{{identifier}}
  auth: inherit
}

params:path {
  identifier: google.com
}

params:query {
  ~providers: wikidata,company-enrich
}

docs {
  Fetch a single company by identifier (name or domain) from external APIs.
  
  Path Parameters:
  - `identifier`: company name or domain (e.g., "google.com" or "Google Inc")
  
  Query Parameters:
  - `providers`: comma-separated list of providers to try (wikidata, company-enrich), default: wikidata,company-enrich
  
  Returns raw company data from the first provider that finds a match.
  
  - 200: OK - company data from external API
  - 404: Not Found - company not found in any provider
  - 401: Unauthorized - run Login
}
