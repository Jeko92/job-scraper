meta {
  name: List skills
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/skills?limit=20
  body: none
  auth: inherit
}

params:query {
  limit: 20
  ~search: script
}

docs {
  Skills ordered by name. Enable a query param to filter.
  
  - `search`: case-insensitive match on the name
  - `limit`: 1–200, default 50
  - 400: invalid filter · 401: run Login
}
