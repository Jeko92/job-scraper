// JobScraper database schema (v1)
//
// How to view: this file is written in DBML (Database Markup Language).
// To see it as an ER diagram, copy the whole file and paste it into the
// editor at https://dbdiagram.io/d. The diagram renders automatically.
//
// How the tables are defined:
// - Every main table (users, user_profiles, user_preferences, skills,
//   industries, locations, companies, jobs, crawl_targets, crawl_runs) uses
//   a uuid `id` primary key. All timestamps are `timestamptz`.
// - users holds login data. user_profiles holds personal and career data,
//   1:1 with users (user_profiles.user_id is unique and not null).
// - user_preferences holds job-search preferences (remote, employment type,
//   minimum salary and currency, willingness to relocate), 1:1 with
//   user_profiles (user_preferences.user_profile_id is unique and not null).
// - skills, industries and locations are shared lookup tables. They are
//   admin-managed and seeded via migrations, never created on demand.
//   Skills and industries have a unique name and a URL-friendly slug.
//   A profile's location is optional.
// - user_profiles.seniority is one of INTERN, JUNIOR, MID, SENIOR, LEAD
//   (SENIORITY_LEVELS in packages/shared), or null.
// - user_skills, user_industries, user_preferences_locations,
//   company_locations, company_skills, company_industries and job_skills are
//   many-to-many join tables. They use composite primary keys and can carry
//   extra data (e.g. skill level, industry priority, whether a job skill is
//   required).
// - user_preferences_locations holds the locations a user would relocate to
//   (at most 4, MAX_PREFERENCES_LOCATIONS in packages/shared).
// - user_saved_jobs is the user's personal list of saved jobs. It links
//   users (not user_profiles, since the login identifies the user) to jobs,
//   with a composite primary key and the time the job was saved.
// - user_job_match stores how well each active job fits each user's profile
//   (0-100, ADR-011). POST /job-matches/calculate replaces all rows; a
//   user-job pair without a row has no match (e.g. no preferences set).
//
// Crawling flow:
// - companies -> crawl_targets: each company has one or more career-page
//   URLs to crawl, scheduled by `next_crawl_at`.
// - crawl_targets -> crawl_runs: one row per crawl attempt, with status and
//   counters (pages crawled, jobs found).
// - crawl_runs -> jobs: postings found by a run. Jobs are deduplicated per
//   company by `source_url` or `external_id`. `first_seen_at`,
//   `last_seen_at` and `is_active` track the lifecycle; a job that is no
//   longer seen gets deactivated instead of deleted.
// - job_skills links jobs to the skills lookup, which is what user_skills is
//   matched against.
//
// On delete (not expressible with inline refs, enforced in the backend):
// - Rows owned by a user (user_profiles, user_preferences, user_skills,
//   user_industries, user_preferences_locations) cascade from their parent.
// - Rows owned by a company (company_locations, company_skills,
//   company_industries, jobs) cascade from it. job_skills cascade from
//   their job.
// - user_saved_jobs and user_job_match rows cascade from both their user
//   and their job.
// - Deleting a skill, industry or location also deletes the user_skills,
//   user_industries, user_preferences_locations, company_locations,
//   company_skills, company_industries or job_skills rows that point to it.
// - user_profiles.location_id, jobs.location_id and jobs.crawl_run_id are
//   set to null.
//
// Relation markers: `ref: -` is one-to-one, `ref: >` is many-to-one,
// `ref: >?` is an optional (nullable) many-to-one.

Table users {
  id uuid [pk]
  email varchar [unique] // optional
  username varchar [unique, not null]
  password_hash varchar [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table user_profiles {
  id uuid [pk]
  user_id uuid [unique, ref: - users.id, not null]
  first_name varchar
  last_name varchar
  headline varchar
  years_experience decimal(4,1)
  seniority varchar(50) // INTERN | JUNIOR | MID | SENIOR | LEAD
  onboarding_completed boolean [not null, default: false]
  location_id uuid [ref: >? locations.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table user_preferences {
  id uuid [pk]
  user_profile_id uuid [unique, ref: - user_profiles.id, not null]
  remote_preference varchar(50)
  employment_type varchar(50)
  min_salary decimal(12,2)
  salary_currency char(3) // ISO 4217, e.g. EUR
  willing_to_relocate boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table skills {
  id uuid [pk]
  name varchar [unique, not null]
  slug varchar [unique, not null]
}

Table industries {
  id uuid [pk]
  name varchar [unique, not null]
  slug varchar [unique, not null]
}

Table locations {
  id uuid [pk]
  country_code varchar // ISO 3166-1 alpha-2, e.g. DE
  country_name varchar
  state_name varchar
  city varchar
  postal_code varchar
}

Table user_skills {
  user_profile_id uuid [ref: > user_profiles.id]
  skill_id uuid [ref: > skills.id]

  level varchar
  years_experience decimal(4,1)

  indexes {
    (user_profile_id, skill_id) [pk]
  }
}

Table user_preferences_locations {
  user_profile_id uuid [ref: > user_profiles.id]
  location_id uuid [ref: > locations.id]

  indexes {
    (user_profile_id, location_id) [pk]
  }
}

Table user_industries {
  user_profile_id uuid [ref: > user_profiles.id]
  industry_id uuid [ref: > industries.id]

  priority int

  indexes {
    (user_profile_id, industry_id) [pk]
  }
}

Table companies {
  id uuid [pk]
  name varchar
  legal_name varchar
  domain varchar [unique]
  website_url varchar
  company_type varchar
  description text
  number_of_employees int // exact count, if the source gives one
  employee_range varchar // e.g. "51-200", if the source only gives a range
  founding_year int
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table company_locations {
  company_id uuid [ref: > companies.id]
  location_id uuid [ref: > locations.id]

  indexes {
    (company_id, location_id) [pk]
  }
}

// Curated tech stack of a company. Skills found in its job postings live
// in job_skills.
Table company_skills {
  company_id uuid [ref: > companies.id]
  skill_id uuid [ref: > skills.id]

  indexes {
    (company_id, skill_id) [pk]
  }
}

Table company_industries {
  company_id uuid [ref: > companies.id]
  industry_id uuid [ref: > industries.id]

  indexes {
    (company_id, industry_id) [pk]
  }
}

Table jobs {
  id uuid [pk]

  // Relationships
  // company_id should equal crawl_runs -> crawl_targets.company_id; the
  // backend enforces this, the database does not.
  company_id uuid [not null, ref: > companies.id]
  location_id uuid [ref: >? locations.id] // primary location only (MVP)
  crawl_run_id uuid [ref: >? crawl_runs.id] // latest run that saw the job, updated with last_seen_at; null for seeded/manual jobs; not created yet, added with the crawl_runs migration

  // Job information
  title varchar(255) [not null]
  description text
  employment_type varchar(50)
  workplace_type varchar(50)

  // Source identification
  source_url varchar(2048) [not null]
  external_id varchar(255) // id from the source site, if any

  // Salary
  salary_min decimal(12,2)
  salary_max decimal(12,2)
  salary_currency char(3)

  // Dates
  published_at timestamptz
  first_seen_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz [not null, default: `now()`]

  // Lifecycle
  is_active boolean [not null, default: true] // false once no longer seen

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, source_url) [unique]
    // NULL external_ids never conflict, so source_url is the fallback key
    (company_id, external_id) [unique]
    (location_id)
    (is_active, last_seen_at)
    (published_at)
  }
}

Table job_skills {
  job_id uuid [not null, ref: > jobs.id]
  skill_id uuid [not null, ref: > skills.id]

  required boolean [not null, default: true] // false = nice-to-have

  indexes {
    (job_id, skill_id) [pk]
    (skill_id, job_id) // find jobs by skill
  }
}

// Jobs a user has saved to their personal list.
Table user_saved_jobs {
  user_id uuid [not null, ref: > users.id]
  job_id uuid [not null, ref: > jobs.id]

  created_at timestamptz [not null, default: `now()`] // when the job was saved

  indexes {
    (user_id, job_id) [pk]
    (user_id, created_at) // list a user's saved jobs, newest first
  }
}

// How well a job fits a user's profile, filled by POST /job-matches/calculate.
Table user_job_match {
  user_id uuid [not null, ref: > users.id]
  job_id uuid [not null, ref: > jobs.id]

  match smallint [not null] // 0-100
  calculated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, job_id) [pk]
    (user_id, match) // sort a user's jobs by best match
  }
}

// Career-page URLs to crawl, per company.
Table crawl_targets {
  id uuid [pk]

  company_id uuid [not null, ref: > companies.id]

  url varchar(2048) [not null]

  is_active boolean [not null, default: true]

  last_crawled_at timestamptz
  next_crawl_at timestamptz

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, url) [unique]
    (is_active, next_crawl_at) // pick the next targets due
  }
}

// One row per crawl attempt of a target.
Table crawl_runs {
  id uuid [pk]

  crawl_target_id uuid [not null, ref: > crawl_targets.id]

  started_at timestamptz [not null]
  finished_at timestamptz // null while running

  status varchar(30) [not null] // possible values - running, succeeded, partial, failed
  pages_crawled int [not null, default: 0]
  jobs_found int [not null, default: 0]

  error_message text

  created_at timestamptz [not null]

  indexes {
    (crawl_target_id, started_at)
    (status, started_at)
  }
}
