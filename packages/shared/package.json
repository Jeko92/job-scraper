{
  "name": "@job-scraper/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Types and utilities shared by backend and frontend",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@job-scraper/eslint-config": "workspace:*",
    "@job-scraper/tsconfig": "workspace:*",
    "eslint": "^9.39.5",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
